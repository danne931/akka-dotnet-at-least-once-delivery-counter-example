<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>CS8625, CS8604</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Cluster.Hosting" Version="1.5.22" />
    <PackageReference Include="Akka.Cluster.Sharding" Version="1.5.22" />
    <PackageReference Include="Akka.Cluster.Tools" Version="1.5.22" />
    <PackageReference Include="Akka.Hosting" Version="1.5.22" />
    <PackageReference Include="Akka.Persistence" Version="1.5.22" />
    <PackageReference Include="Akka.Persistence.Hosting" Version="1.5.22" />
  </ItemGroup>

</Project>
